import QtQuick
Item {
    id: root
    property var screen: null
    property bool showCondition: false
    property bool previewsEnabled: false
    property string textFontFamily: ""
    property string heroFontFamily: ""
    property string wallpaperPath: ""
    property real windowCornerRadius: 22
    property alias overviewView: overviewView
    property alias overviewDataReady: hyprlandData.ready
    signal closeRequested()
    anchors.fill: parent
    HyprlandData {
        id: hyprlandData
    }
WorkspaceOverviewLayer {
        id: overviewView
        anchors.centerIn: parent
        screen: root.screen
        hyprlandData: hyprlandData
        showCondition: root.showCondition
        previewsEnabled: root.previewsEnabled
        textFontFamily: root.textFontFamily
        heroFontFamily: root.heroFontFamily
        wallpaperPath: root.wallpaperPath
        windowCornerRadius: root.windowCornerRadius
        onCloseRequested: root.closeRequested()
    }

    // ── Special Workspaces section ────────────────────────────────────────────
    Item {
        id: specialSection
        visible: root.showCondition && specialRepeater.count > 0
        anchors.top: overviewView.bottom
        anchors.topMargin: 8
        anchors.horizontalCenter: parent.horizontalCenter
        width: overviewView.width
        height: visible ? (specialHeaderHeight + specialCellHeight + overviewView.outerPadding * 2) : 0

        readonly property real specialCellHeight: overviewView.workspaceImplicitHeight
        readonly property real specialCellWidth: overviewView.workspaceImplicitWidth
        readonly property real specialHeaderHeight: 28
        readonly property var specialWorkspaces: {
            const all = hyprlandData.workspaces ?? [];
            return all.filter(ws => ws.id < 0);
        }

        Rectangle {
            anchors.fill: parent
            color: overviewView.cardColor
            radius: overviewView.largeWorkspaceRadius
            border.width: 1
            border.color: overviewView.cardBorderColor
        }

        Text {
            id: specialHeader
            anchors.top: parent.top
            anchors.topMargin: 8
            anchors.left: parent.left
            anchors.leftMargin: overviewView.outerPadding
            text: "Special Workspaces"
            color: "#ffffff"
            opacity: 0.55
            font.pixelSize: 12
            font.weight: Font.Medium
        }

        Row {
            anchors.top: specialHeader.bottom
            anchors.topMargin: 4
            anchors.horizontalCenter: parent.horizontalCenter
            spacing: overviewView.workspaceSpacing

            Repeater {
                id: specialRepeater
                model: specialSection.specialWorkspaces

                delegate: Rectangle {
                    id: specCell
                    required property var modelData
                    readonly property var ws: modelData
                    readonly property var windows: {
                        const ba = hyprlandData.windowByAddress ?? {};
                        return Object.values(ba).filter(w => w.workspace && w.workspace.id === ws.id);
                    }

                    width: specialSection.specialCellWidth
                    height: specialSection.specialCellHeight
                    color: overviewView.workspaceColor
                    radius: overviewView.smallWorkspaceRadius
                    border.width: 1
                    border.color: "#33ffffff"
                    clip: true

                    // Workspace name label
                    Text {
                        anchors.centerIn: parent
                        text: specCell.ws.name ? specCell.ws.name.replace("special:", "") : ""
                        color: "#ffffff"
                        opacity: specCell.windows.length > 0 ? 0.0 : 0.22
                        font.pixelSize: Math.max(10, Math.min(specCell.width, specCell.height) * 0.18)
                        font.weight: Font.DemiBold
                    }

                    // App icons for windows in this special workspace
                    Flow {
                        anchors.fill: parent
                        anchors.margins: 6
                        spacing: 4

                        Repeater {
                            model: specCell.windows
                            delegate: Image {
                                required property var modelData
                                readonly property string iconName: modelData.class || modelData.initialClass || modelData.title || "application-x-executable"
                                width: 24; height: 24
                                source: Quickshell.iconPath(iconName, "image-missing")
                                sourceSize: Qt.size(24, 24)
                                mipmap: true
                                smooth: true
                                fillMode: Image.PreserveAspectFit
                            }
                        }
                    }

                    MouseArea {
                        anchors.fill: parent
                        onClicked: {
                            const wsName = specCell.ws.name ?? ""
                            Hyprland.dispatch("togglespecialworkspace " + wsName.replace("special:", ""))
                            root.closeRequested()
                        }
                    }
                }
            }
        }
    }

    // ── Workspace number labels ───────────────────────────────────────────────
    Item {
        visible: root.showCondition
        anchors.centerIn: parent
        width:  overviewView.width  - overviewView.outerPadding * 2
        height: overviewView.height - overviewView.outerPadding * 2

        Repeater {
            model: overviewView.rows * overviewView.columns
            delegate: Item {
                id: wsLabel
                required property int index
                readonly property int col: index % overviewView.columns
                readonly property int row: Math.floor(index / overviewView.columns)
                readonly property real cellW: overviewView.workspaceImplicitWidth
                readonly property real cellH: overviewView.workspaceImplicitHeight
                readonly property real gap:   overviewView.workspaceSpacing
                readonly property int  wsNum: overviewView.workspaceGroup * overviewView.workspacesShown
                                              + row * overviewView.columns + col + 1
                x: col * (cellW + gap)
                y: row * (cellH + gap)
                width: cellW
                height: cellH

                Text {
                    anchors.centerIn: parent
                    text: wsLabel.wsNum
                    font.pixelSize: Math.max(10, Math.min(wsLabel.cellW, wsLabel.cellH) * 0.18)
                    font.weight: Font.DemiBold
                    color: "#ffffff"
                    opacity: 0.22
                }
            }
        }
    }
}

